#!/bin/sh
set -u

resolve_script() {
    target=$1
    while [ -L "$target" ]; do
        directory=$(CDPATH= cd -- "$(dirname -- "$target")" && pwd -P) || return 1
        link=$(readlink "$target") || return 1
        case "$link" in
            /*) target=$link ;;
            *) target=$directory/$link ;;
        esac
    done
    directory=$(CDPATH= cd -- "$(dirname -- "$target")" && pwd -P) || return 1
    printf '%s/%s\n' "$directory" "$(basename -- "$target")"
}

SCRIPT_PATH=$(resolve_script "$0") || {
    printf '%s\n' 'agent: could not resolve installation path' >&2
    exit 1
}
PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)

# shellcheck source=../lib/amphetamine.sh
. "$PROJECT_ROOT/lib/amphetamine.sh"
# shellcheck source=../lib/sessions.sh
. "$PROJECT_ROOT/lib/sessions.sh"
# shellcheck source=../lib/lock.sh
. "$PROJECT_ROOT/lib/lock.sh"
# shellcheck source=../lib/doctor.sh
. "$PROJECT_ROOT/lib/doctor.sh"

trap 'lock_release' EXIT
trap 'lock_release; exit 129' HUP
trap 'lock_release; exit 130' INT
trap 'lock_release; exit 143' TERM

usage() {
    cat <<'EOF'
Usage: agent [command]

  agent                Enter this folder's persistent shell
  agent wake           Start Amphetamine
  agent sleep          End Amphetamine
  agent status         Show this folder's session and wake state
  agent list           List managed sessions
  agent stop [--all]   Stop managed session(s)
  agent doctor         Check readiness
  agent help           Show this help
EOF
}

power_source() {
    doctor_power_source
}

warn_if_on_battery() {
    [ "$(power_source)" != 'Battery Power' ] || \
        printf '%s\n' 'Warning: running on battery; Amphetamine is configured to end at 30%.' >&2
}

wait_for_protection_state() {
    expected=$1
    attempts=0
    while [ "$attempts" -lt 8 ]; do
        [ "$(doctor_sleep_disabled)" = "$expected" ] && return 0
        attempts=$((attempts + 1))
        /bin/sleep 1
    done
    printf 'agent: closed-display protection did not reach SleepDisabled=%s\n' "$expected" >&2
    return 1
}

enable_wake_protection() {
    active_before=$(amphetamine_get_active) || return 1
    amphetamine_start || return 1
    if ! wait_for_protection_state 1; then
        [ "$active_before" = true ] || amphetamine_end >/dev/null 2>&1 || true
        return 1
    fi
    warn_if_on_battery
}

disable_wake_protection() {
    amphetamine_end || return 1
    wait_for_protection_state 0
}

command_status() {
    root=$(canonical_root .) || return 1
    name=$(session_name_for_root "$root") || return 1
    if session_for_root "$root" >/dev/null 2>&1; then
        session_state=running
    else
        session_state=stopped
    fi
    wake_state=$(amphetamine_state) || return 1
    sleep_disabled=$(doctor_sleep_disabled)
    if [ "$wake_state" = active ] && [ "$sleep_disabled" = 1 ]; then
        readiness=ready
    elif [ "$wake_state" = inactive ] && [ "$sleep_disabled" = 0 ]; then
        readiness=inactive
    else
        readiness="not-ready (SleepDisabled=${sleep_disabled:-unknown})"
    fi
    source=$(power_source)
    printf 'Project: %s\nSession: %s (%s)\nAmphetamine: %s\nClosed-display protection: %s\nPower: %s\n' \
        "$root" "$name" "$session_state" "$wake_state" "$readiness" "${source:-unknown}"
}

command_list() {
    listing=$(sessions_list_managed) || return 1
    printf '%s\n' "$listing" | while IFS="$(printf '\t')" read -r name root; do
        [ -n "$name" ] || continue
        printf '%s  %s\n' "$name" "$root"
    done
}

command_enter() {
    sessions_require_tmux || return 1
    lock_acquire || return 1
    active_before=$(amphetamine_get_active) || return 1
    enable_wake_protection || return 1
    root=$(canonical_root .) || return 1
    if ! name=$(sessions_create "$root"); then
        if [ "$active_before" = false ] && [ "$(sessions_count_managed)" -eq 0 ]; then
            amphetamine_end >/dev/null 2>&1 || true
        fi
        return 1
    fi
    printf 'Agent Helper: %s\n' "$root"
    printf 'Persistent shell: %s · detach with Ctrl-B, then D\n' "$name"
    lock_release
    [ "${AGENT_NONINTERACTIVE:-0}" != 1 ] || return 0
    sessions_attach "$name"
}

command_wake() {
    lock_acquire || return 1
    enable_wake_protection
}

command_sleep() {
    force=${1:-false}
    lock_acquire || return 1
    count=$(sessions_count_managed) || return 1
    if [ "$count" -gt 0 ] && [ "$force" != true ]; then
        printf 'agent: refusing to end Amphetamine while %s managed session(s) remain\n' "$count" >&2
        printf '%s\n' 'Use agent sleep --force to override without stopping tmux.' >&2
        return 1
    fi
    if [ "$count" -gt 0 ]; then
        printf 'WARNING: ending Amphetamine while %s managed session(s) remain; tmux sessions will keep running only while macOS stays awake.\n' "$count" >&2
    fi
    disable_wake_protection
}

command_stop() {
    mode=${1:-current}
    lock_acquire || return 1
    if [ "$mode" = all ]; then
        names=$(sessions_managed_names) || return 1
        for name in $names; do
            session_stop "$name" || return 1
        done
    else
        root=$(canonical_root .) || return 1
        name=$(session_name_for_root "$root") || return 1
        if ! session_exists "$name"; then
            printf '%s\n' 'No managed session exists for this folder.'
        else
            session_is_managed "$name" && [ "$(session_root "$name")" = "$root" ] || {
                printf 'agent: refusing to stop colliding or unmanaged session %s\n' "$name" >&2
                return 1
            }
            session_stop "$name" || return 1
        fi
    fi
    remaining=$(sessions_count_managed) || return 1
    if [ "$remaining" -eq 0 ]; then
        disable_wake_protection
    else
        printf 'Amphetamine remains active for %s managed session(s).\n' "$remaining"
    fi
}

case "${1:-}" in
    '') command_enter ;;
    wake) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; command_wake ;;
    sleep)
        case "${2:-}" in
            '') [ "$#" -eq 1 ] || { usage >&2; exit 2; }; command_sleep false ;;
            --force) [ "$#" -eq 2 ] || { usage >&2; exit 2; }; command_sleep true ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    status) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; command_status ;;
    list) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; command_list ;;
    help|-h|--help) usage ;;
    stop)
        case "${2:-}" in
            '') [ "$#" -eq 1 ] || { usage >&2; exit 2; }; command_stop current ;;
            --all) [ "$#" -eq 2 ] || { usage >&2; exit 2; }; command_stop all ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    doctor) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; doctor_run ;;
    *)
        printf 'agent: unknown command: %s\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac
