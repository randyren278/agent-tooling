#!/bin/sh
set -eu

state=${AGENT_TEST_AMPHETAMINE_STATE:?}
script=${2:-}
[ "${AGENT_TEST_OSASCRIPT_FAILURE:-}" != all ] || exit 13
[ "${AGENT_TEST_OSASCRIPT_FAILURE:-}" != query ] || case "$script" in
    *'session is active'*) exit 13 ;;
esac
[ "${AGENT_TEST_OSASCRIPT_FAILURE:-}" != end ] || case "$script" in
    *'end session'*) exit 13 ;;
esac
active=false
[ ! -f "$state" ] || active=$(cat "$state")
case "$script" in
    *'session is active'*) printf '%s\n' "$active" ;;
    *'start new session'*) printf '%s\n' true >"$state" ;;
    *'end session'*) printf '%s\n' false >"$state" ;;
    *) printf 'fake-osascript: unsupported script: %s\n' "$script" >&2; exit 2 ;;
esac
