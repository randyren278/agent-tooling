#!/bin/sh
set -eu

case "$(basename "$0")" in
    pmset)
        if [ "${2:-}" = batt ]; then
            printf "%s\n" "Now drawing from 'Battery Power'"
            printf '%s\n' ' -InternalBattery-0 (id=1)  20%; discharging; present: true'
        else
            active=false
            [ ! -f "${AGENT_TEST_AMPHETAMINE_STATE:-}" ] || active=$(cat "$AGENT_TEST_AMPHETAMINE_STATE")
            [ "$active" = true ] && printf '%s\n' ' SleepDisabled 1' || printf '%s\n' ' SleepDisabled 0'
        fi
        ;;
    uname) printf '%s\n' arm64 ;;
    sw_vers)
        [ "${1:-}" = -productVersion ] && printf '%s\n' 99.1 || printf '%s\n' 99A1
        ;;
    system_profiler) printf '%s\n' '      Model Identifier: TestMac1,1' ;;
    mdls) printf '%s\n' 5.3.2 ;;
    *) exit 2 ;;
esac
